!/docs/i18n.js
!/docs/i18n-gloss.js
!/docs/fold.js
!/docs/vendor/
!/docs/icons/
!/docs/terminal/
/docs/terminal/*
!/docs/terminal/overrides.json
/data/ann_latency.json
/data/ipos.json
/data/watchlist.json
/data/watchlist_changes.json
